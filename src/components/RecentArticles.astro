---
import { getCollection } from 'astro:content';

const docs = await getCollection('docs');
const now = new Date();
const sevenDaysAgo = new Date(now);
sevenDaysAgo.setDate(now.getDate() - 7);

const recentArticles = docs
	.filter(doc => {
		const date = doc.data.date;
		return date instanceof Date && date >= sevenDaysAgo;
	})
	.sort((a, b) => {
		const da = a.data.date instanceof Date ? a.data.date.getTime() : 0;
		const db = b.data.date instanceof Date ? b.data.date.getTime() : 0;
		return db - da;
	})
	.slice(0, 5);

function formatDate(date: Date): string {
	return date.toLocaleDateString('en-GB', {
		day: 'numeric',
		month: 'short',
		year: 'numeric',
	});
}

function getPillarFromId(id: string): string {
	const segment = id.split('/')[0];
	const labels: Record<string, string> = {
		'foundations': 'Foundations',
		'attack-and-red-team': 'Attack & Red Team',
		'defend-and-harden': 'Defend & Harden',
		'architecture-and-platform': 'Architecture & Platform',
		'governance-risk-compliance': 'GRC',
		'emerging-threats-and-research': 'Emerging Threats',
	};
	return labels[segment] ?? segment;
}
---

{recentArticles.length > 0 && (
	<section class="recent-articles">
		<h2 class="recent-heading">Recently Added</h2>
		<ul class="recent-list">
			{recentArticles.map(article => (
				<li class="recent-item">
					<a href={`/${article.id}/`} class="recent-link">
						<span class="recent-meta">
							<span class="recent-pillar">{getPillarFromId(article.id)}</span>
							<span class="recent-date">{formatDate(article.data.date!)}</span>
						</span>
						<span class="recent-title">{article.data.title}</span>
						{article.data.description && (
							<span class="recent-desc">{article.data.description}</span>
						)}
					</a>
				</li>
			))}
		</ul>
	</section>
)}

<style>
	.recent-articles {
		margin-block: 0.5rem 1.5rem;
	}

	.recent-heading {
		font-size: var(--sl-text-lg);
		font-weight: 600;
		color: var(--sl-color-white);
		margin-bottom: 1rem;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid var(--sl-color-gray-5);
	}

	.recent-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.recent-item {
		margin: 0;
	}

	.recent-link {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
		padding: 0.875rem 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		text-decoration: none;
		transition: background-color 0.15s ease, border-color 0.15s ease;
	}

	.recent-link:hover {
		background: var(--sl-color-gray-7, var(--sl-color-gray-6));
		border-color: var(--sl-color-gray-2);
	}

	.recent-meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-size: var(--sl-text-xs);
		font-family: var(--sl-font-system-mono);
	}

	.recent-pillar {
		color: var(--sl-color-text-accent);
	}

	.recent-date {
		color: var(--sl-color-gray-3);
	}

	.recent-title {
		color: var(--sl-color-white);
		font-weight: 600;
		font-size: var(--sl-text-base);
		line-height: var(--sl-line-height-headings);
	}

	.recent-desc {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>
